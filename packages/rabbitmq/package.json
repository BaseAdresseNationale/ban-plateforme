{
  "name": "@ban/rabbitmq",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/pipeline.ts --format esm --dts",
    "dev": "tsup src/index.ts src/pipeline.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "rascal": "^20.1.1"
  },
  "devDependencies": {
    "@types/rascal": "^10.2.1"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./pipeline": { "types": "./dist/pipeline.d.ts", "default": "./dist/pipeline.js" }
  }
}
