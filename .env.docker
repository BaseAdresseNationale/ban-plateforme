# Configuration locale Docker.
# Ordre commun par service ; les options absentes restent commentees.
# Les valeurs de connexion historiques restent au-dessus de leur remplacement.

# === Execution Node.js ===
# NODE_ENV=
# Node (optionnel)
NODE_OPTIONS=--experimental-require-module

# === PostgreSQL ===
# Postgres
PG_HOST=postgres
PG_PORT=5432
# PG_DB=ban
PG_DB=ban_restore_validation
PG_USER=ban_user
PG_PASSWORD=ban_pass
# PostgreSQL credentials # PG_URI=postgres://$PG_USER:$PG_PASSWORD@$PG_HOST:$PG_PORT/$PG_DB
# PG_URI=postgres://ban_user:ban_pass@postgres:5432/ban
PG_URI=postgres://ban_user:ban_pass@postgres:5432/ban_restore_validation
# PG_URL=postgres://user:pass@postgres:5432/ban?schema=ban
PG_URL=postgres://ban_user:ban_pass@postgres:5432/ban_restore_validation?schema=ban

# === pgAdmin (Compose et scripts de deploiement) ===
# PGADMIN (for dev Only)
PGADMIN_PORT=8082
# PGADMIN_REPLACE_SERVERS_ON_STARTUP=
# Meme valeur que PGADMIN_EMAIL.
PGADMIN_DEFAULT_EMAIL=admin@ban.fr
# Meme valeur que PGADMIN_PASSWORD.
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_EMAIL=admin@ban.fr
PGADMIN_PASSWORD=admin

# === MongoDB ===
# Mongo DB # MONGO_URI=mongodb://$MONGO_HOST:$MONGO_PORT/$MONGO_DB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=ban
# MONGO_USER=
# MONGO_PASSWORD=
MONGO_URI=mongodb://mongo:27017/ban
# MONGO_URI=mongodb://$MONGO_HOST:$MONGO_PORT/$MONGO_DB

# === Mongo Express ===
# Mongo Express (for dev Only)
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# === RabbitMQ ===
# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBIT_URL=amqp://rabbitmq:5672
# RABBIT_URL=amqp://$RABBITMQ_USER:$RABBITMQ_PASSWORD@$RABBITMQ_HOST:$RABBITMQ_PORT

# === RustFS (stockage S3 local) ===
# RustFS local S3
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9002
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# === Exports : stockage et fichiers temporaires ===
# Exports
EXPORT_STORAGE=s3
# EXPORT_OUTPUT_DIR=
EXPORT_TEMP_FILE_MAX_AGE_HOURS=24

# === Exports : acces S3 ===
EXPORT_S3_BUCKET=ban-exports
EXPORT_S3_ENDPOINT=http://rustfs:9000
EXPORT_S3_REGION=us-east-1
EXPORT_S3_ACCESS_KEY_ID=rustfsadmin
EXPORT_S3_SECRET_ACCESS_KEY=rustfsadmin
EXPORT_S3_PREFIX=exports
EXPORT_S3_FORCE_PATH_STYLE=true
# EXPORT_S3_PUBLIC_BASE_URL=

# === API BAN et services externes ===
#Ban Core Api
PORT=3000 # À changer le nom de la variable 
# BAN_CORE_API_PORT=
# API_BAL_ASSEMBLY_URL=
# API_DEPOT_URL=
# BAN_API_URL=

# === Ancienne configuration MinIO (options conservees) ===
# MINIO_API_PORT=
# MINIO_CONSOLE_PORT=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# === Anciennes configurations S3 (options conservees) ===
# S3_CONFIG_ACCESS_KEY_ID=
# S3_CONFIG_SECRET_ACCESS_KEY=
# S3_CONFIG_REGION=
# S3_CONFIG_ENDPOINT=
# S3_CONFIG_BUCKETNAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_ENDPOINT=
# S3_BUCKETNAME=
# S3_MAXKEYS=
# S3_PORT=
