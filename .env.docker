# Postgres
PG_HOST=postgres
PG_PORT=5432
PG_DB=ban
PG_USER=ban_user
PG_PASSWORD=ban_pass

# PostgreSQL credentials # PG_URI=postgres://$PG_USER:$PG_PASSWORD@$PG_HOST:$PG_PORT/$PG_DB
PG_URI=postgres://ban_user:ban_pass@postgres:5432/ban
PG_URL=postgres://user:pass@localhost:5432/ban?schema=ban

# PGADMIN (for dev Only)
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@ban.fr
PGADMIN_PASSWORD=admin

# Mongo DB # MONGO_URI=mongodb://$MONGO_HOST:$MONGO_PORT/$MONGO_DB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=ban
MONGO_URI=mongodb://mongo:27017/ban
# MONGO_URI=mongodb://$MONGO_HOST:$MONGO_PORT/$MONGO_DB

# Mongo Express (for dev Only)
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBIT_URL=amqp://rabbitmq:5672
# RABBIT_URL=amqp://$RABBITMQ_USER:$RABBITMQ_PASSWORD@$RABBITMQ_HOST:$RABBITMQ_PORT

# MinIO local S3
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Exports
EXPORT_STORAGE=s3
EXPORT_S3_BUCKET=ban-exports
EXPORT_S3_ENDPOINT=http://minio:9000
EXPORT_S3_REGION=us-east-1
EXPORT_S3_ACCESS_KEY_ID=minioadmin
EXPORT_S3_SECRET_ACCESS_KEY=minioadmin
EXPORT_S3_PREFIX=exports
EXPORT_S3_FORCE_PATH_STYLE=true

# Node (optionnel)
NODE_OPTIONS=--experimental-require-module

#Ban Core Api
PORT=3000 # À changer le nom de la variable 
