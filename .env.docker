# Modèle de développement pour les services connectés au réseau Docker.
# Garder les surcharges propres au poste dans une configuration locale non versionnée.

# Node.js (optionnel)
NODE_OPTIONS=--experimental-require-module

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DB=ban
PG_USER=ban_user
PG_PASSWORD=ban_pass

# URLs explicites : vérifier leur cohérence avec les variables PostgreSQL ci-dessus.
# Les valeurs partagées sont des exemples de développement, à adapter localement.
PG_URI=postgres://ban_user:ban_pass@postgres:5432/ban
PG_URL=postgres://user:pass@postgres:5432/ban?schema=ban

# PgAdmin (développement)
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@ban.fr
PGADMIN_PASSWORD=admin

# MongoDB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=ban
MONGO_URI=mongodb://mongo:27017/ban
# MONGO_URI=mongodb://$MONGO_HOST:$MONGO_PORT/$MONGO_DB

# Mongo Express (développement)
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBIT_URL=amqp://rabbitmq:5672
# RABBIT_URL=amqp://$RABBITMQ_USER:$RABBITMQ_PASSWORD@$RABBITMQ_HOST:$RABBITMQ_PORT

# RustFS (stockage S3 local)
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9002
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Exporteur : stockage et conservation des fichiers temporaires
EXPORT_STORAGE=s3
EXPORT_TEMP_FILE_MAX_AGE_HOURS=24
EXPORT_S3_BUCKET=ban-exports
EXPORT_S3_ENDPOINT=http://rustfs:9000
EXPORT_S3_REGION=us-east-1
EXPORT_S3_ACCESS_KEY_ID=rustfsadmin
EXPORT_S3_SECRET_ACCESS_KEY=rustfsadmin
EXPORT_S3_PREFIX=exports
EXPORT_S3_FORCE_PATH_STYLE=true

# API HTTP
PORT=3000 # À changer le nom de la variable 
