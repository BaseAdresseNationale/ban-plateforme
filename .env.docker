# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=ban
PG_USER=ban_user
PG_PASSWORD=ban_pass
PG_ROOT_USER=postgres
PG_ROOT_PASSWORD=postgres
PG_URI=postgres://ban_user:ban_pass@localhost:5432/ban
PG_URL=postgres://ban_user:ban_pass@localhost:5432/ban
PG_DATA_PATH=db-migrations/data

# Postal Code Service
POSTAL_CODE_ADMIN_TOKEN=
POSTAL_CODE_PORT=3001

# PGAdmin
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@ban.fr
PGADMIN_PASSWORD=admin

# Mongo
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=ban
MONGO_URI=mongodb://mongo:27017/ban
# MONGO_URI=mongodb://$MONGO_HOST:$MONGO_PORT/$MONGO_DB

# Mongo Express
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# Rabbit
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBIT_URL=amqp://rabbitmq:5672
# RABBIT_URL=amqp://$RABBITMQ_USER:$RABBITMQ_PASSWORD@$RABBITMQ_HOST:$RABBITMQ_PORT

# Node (optionnel)
NODE_OPTIONS=--experimental-require-module

#Ban Core Api
PORT=3000 # À changer le nom de la variable 