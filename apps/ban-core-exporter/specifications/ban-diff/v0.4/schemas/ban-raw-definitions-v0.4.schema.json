{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ban.example/schemas/ban-raw-definitions-v0.4.schema.json",
  "title":"BAN Raw v0.4 shared definitions",
  "description":"Shared documented object definitions referenced by the Raw Full and Raw DIFF line schemas.",
  "$defs":{
    "uuid":{"type":"string","format":"uuid","description":"Canonical BAN identifier."},
    "datetime":{"type":["string","null"],"format":"date-time","description":"RFC 3339 instant in UTC; null only when explicitly unknown."},
    "point":{"type":"object","description":"WGS84 GeoJSON Point, longitude then latitude.","required":["type","coordinates"],"properties":{"type":{"const":"Point"},"coordinates":{"type":"array","prefixItems":[{"type":"number","minimum":-180,"maximum":180},{"type":"number","minimum":-90,"maximum":90}],"items":false}},"additionalProperties":false},
    "label":{"type":"object","description":"A localized label.","required":["value","isoCode"],"properties":{"value":{"type":"string","minLength":1},"isoCode":{"type":"string","pattern":"^[a-z]{3}$"}},"additionalProperties":false},
    "meta":{"type":"object","description":"Object business metadata.","required":["insee","source"],"properties":{"insee":{"type":"object","required":["cog"],"properties":{"cog":{"type":"string","minLength":1}},"additionalProperties":false},"source":{"type":"string","minLength":1},"interop":{"type":"object","properties":{"balProvidedKey":{"type":"string"},"banComputedKey":{"type":"string"},"legacyCsvId":{"type":"string"}},"additionalProperties":false}},"additionalProperties":false},
    "base":{"type":"object","description":"Fields shared by every BAN entity.","required":["id","labels","status","updatedAt","integratedAt","meta"],"properties":{"id":{"$ref":"#/$defs/uuid"},"labels":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/label"}},"status":{"enum":["active","disabled"]},"updatedAt":{"$ref":"#/$defs/datetime"},"integratedAt":{"$ref":"#/$defs/datetime"},"meta":{"$ref":"#/$defs/meta"}}},
    "district":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","properties":{"historicalDistrictID":{"$ref":"#/$defs/uuid"},"historicalInseeCode":{"type":"string"}}}],"unevaluatedProperties":false},
    "toponym":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["districtID","geometry"],"properties":{"districtID":{"$ref":"#/$defs/uuid"},"geometry":{"$ref":"#/$defs/point"},"historicalDistrictID":{"$ref":"#/$defs/uuid"},"historicalInseeCode":{"type":"string"}}}],"unevaluatedProperties":false},
    "address":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["districtID","mainToponymID","secondaryToponymIDs","certified","positions","postalCodes"],"properties":{"districtID":{"$ref":"#/$defs/uuid"},"mainToponymID":{"$ref":"#/$defs/uuid"},"secondaryToponymIDs":{"type":"array","items":{"$ref":"#/$defs/uuid"}},"number":{"type":"integer","minimum":1},"suffix":{"type":"string","minLength":1},"certified":{"type":"boolean"},"positions":{"type":"array","minItems":1,"items":{"type":"object","required":["type","geometry"],"properties":{"type":{"type":"string","minLength":1},"geometry":{"$ref":"#/$defs/point"}},"additionalProperties":false}},"postalCodes":{"type":"array","items":{"type":"string"}},"historicalDistrictID":{"$ref":"#/$defs/uuid"},"historicalInseeCode":{"type":"string"}}}],"unevaluatedProperties":false},
    "record":{"type":"object","description":"A full-export data line.","required":["type","data"],"properties":{"type":{"enum":["district","toponym","address"]},"nodeKey":{"type":"string"},"data":{"oneOf":[{"$ref":"#/$defs/district"},{"$ref":"#/$defs/toponym"},{"$ref":"#/$defs/address"}]}},"additionalProperties":false},
    "diffRecord":{"type":"object","description":"A differential event line. Updated states are after then before.","required":["event","type","data"],"properties":{"event":{"enum":["created","updated","disabled"]},"type":{"enum":["district","toponym","address"]},"nodeKey":{"type":"string"},"data":{"type":"array","minItems":1,"maxItems":2,"items":{"oneOf":[{"$ref":"#/$defs/district"},{"$ref":"#/$defs/toponym"},{"$ref":"#/$defs/address"}]}}},"additionalProperties":false}
  },
  "type":"object"
}
