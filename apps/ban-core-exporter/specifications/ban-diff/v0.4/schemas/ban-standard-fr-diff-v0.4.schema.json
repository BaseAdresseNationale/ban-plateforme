{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ban.example/schemas/ban-standard-fr-diff-v0.4.schema.json",
  "title":"BAN Standard FR DIFF v0.4 ligne",
  "description":"Valide chaque ligne NDJSON d'un flux différentiel Standard FR.",
  "oneOf":[{"$ref":"#/$defs/debut"},{"$ref":"#/$defs/evenement"},{"$ref":"#/$defs/fin"}],
  "$defs":{
    "debut":{"type":"object","description":"Première ligne du DIFF.","required":["metadonnees"],"properties":{"metadonnees":{"type":"object","required":["note","versionFormat","typeExport","format","typesDonnees","departements","de","a"],"properties":{"note":{"const":"stream-start"},"versionFormat":{"const":"0.4"},"typeExport":{"const":"diff"},"format":{"const":"standard-fr"},"typesDonnees":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["commune","odonyme","adresse"]}},"departements":{"type":"array","items":{"type":"string"}},"de":{"type":"string","format":"date-time","description":"Borne incluse."},"a":{"type":"string","format":"date-time","description":"Borne exclue."}},"additionalProperties":false}},"additionalProperties":false},
    "evenement":{"type":"object","description":"Événement différentiel typé.","required":["evenement","type","donnees"],"properties":{"evenement":{"enum":["created","updated","disabled"]},"type":{"enum":["commune","odonyme","adresse"]},"nodeKey":{"type":"string"},"donnees":{"type":"array"}},"allOf":[
      {"if":{"properties":{"type":{"const":"commune"}}},"then":{"properties":{"donnees":{"items":{"$ref":"ban-standard-fr-definitions-v0.4.schema.json#/$defs/commune"}}}}},
      {"if":{"properties":{"type":{"const":"odonyme"}}},"then":{"properties":{"donnees":{"items":{"$ref":"ban-standard-fr-definitions-v0.4.schema.json#/$defs/odonyme"}}}}},
      {"if":{"properties":{"type":{"const":"adresse"}}},"then":{"properties":{"donnees":{"items":{"$ref":"ban-standard-fr-definitions-v0.4.schema.json#/$defs/adresse"}}}}},
      {"if":{"properties":{"evenement":{"const":"updated"}}},"then":{"properties":{"donnees":{"minItems":2,"maxItems":2}}}},
      {"if":{"properties":{"evenement":{"const":"created"}}},"then":{"properties":{"donnees":{"minItems":1,"maxItems":1,"items":{"properties":{"statut":{"const":"active"}}}}}}},
      {"if":{"properties":{"evenement":{"const":"disabled"}}},"then":{"properties":{"donnees":{"minItems":1,"maxItems":1,"items":{"properties":{"statut":{"const":"disabled"}}}}}}}
    ],"additionalProperties":false},
    "fin":{"type":"object","description":"Dernière ligne du DIFF.","required":["metadonnees"],"properties":{"metadonnees":{"type":"object","required":["note","genereLe","statistiques"],"properties":{"note":{"const":"stream-end"},"genereLe":{"type":"string","format":"date-time"},"statistiques":{"type":"object","additionalProperties":{"type":"object","required":["count","created","updated","disabled"],"properties":{"count":{"type":"integer","minimum":0},"created":{"type":"integer","minimum":0},"updated":{"type":"integer","minimum":0},"disabled":{"type":"integer","minimum":0}},"additionalProperties":false}}},"additionalProperties":false}},"additionalProperties":false}
  }
}
