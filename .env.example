# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=ban
PG_USER=user
PG_PASSWORD=pass

# Adapt to your local PostgreSQL credentials
PG_URI=postgres://user:pass@localhost:5432/ban
PG_URL=postgres://user:pass@localhost:5432/ban?schema=ban


# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ban
MONGO_URI=mongodb://localhost:27017/ban

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBIT_URL=amqp://guest:guest@localhost:5672

# MinIO local S3
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Exports
EXPORT_STORAGE=s3
# EXPORT_OUTPUT_DIR=apps/ban-core-exporter/tmp/exports
EXPORT_S3_BUCKET=ban-exports
EXPORT_S3_ENDPOINT=http://localhost:9000
EXPORT_S3_REGION=us-east-1
EXPORT_S3_ACCESS_KEY_ID=minioadmin
EXPORT_S3_SECRET_ACCESS_KEY=minioadmin
EXPORT_S3_PREFIX=exports
# Si le bucket devient public, cette base permet d'exposer une URL dans le rapport d'export.
# EXPORT_S3_PUBLIC_BASE_URL=
EXPORT_S3_FORCE_PATH_STYLE=true
