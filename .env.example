# Configuration exemple (a personnaliser).
# Ordre commun par service ; les options absentes restent commentees.
# Les valeurs de connexion historiques restent au-dessus de leur remplacement.

# === Execution Node.js ===
# NODE_ENV=
# NODE_OPTIONS=

# === PostgreSQL ===
# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=ban
PG_USER=user
PG_PASSWORD=pass
# Adapt to your local PostgreSQL credentials
PG_URI=postgres://user:pass@localhost:5432/ban
PG_URL=postgres://user:pass@localhost:5432/ban?schema=ban

# === pgAdmin (Compose et scripts de deploiement) ===
PGADMIN_PORT=8082
# PGADMIN_REPLACE_SERVERS_ON_STARTUP=
# Meme valeur que PGADMIN_EMAIL.
PGADMIN_DEFAULT_EMAIL=admin@example.test
# Meme valeur que PGADMIN_PASSWORD.
PGADMIN_DEFAULT_PASSWORD=change-me
# Meme valeur que PGADMIN_DEFAULT_EMAIL.
PGADMIN_EMAIL=admin@example.test
# Meme valeur que PGADMIN_DEFAULT_PASSWORD.
PGADMIN_PASSWORD=change-me

# === MongoDB ===
# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ban
# MONGO_USER=
# MONGO_PASSWORD=
MONGO_URI=mongodb://localhost:27017/ban

# === Mongo Express ===
# MONGO_EXPRESS_PORT=
# MONGO_EXPRESS_USER=
# MONGO_EXPRESS_PASSWORD=

# === RabbitMQ ===
# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBIT_URL=amqp://guest:guest@localhost:5672

# === RustFS (stockage S3 local) ===
# RustFS local S3
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9002
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# === Exports : stockage et fichiers temporaires ===
# Exports
EXPORT_STORAGE=s3
# EXPORT_OUTPUT_DIR=apps/ban-core-exporter/tmp/exports
# Durée de conservation des fichiers temporaires en mode S3 (heures)
EXPORT_TEMP_FILE_MAX_AGE_HOURS=24

# === Exports : acces S3 ===
EXPORT_S3_BUCKET=ban-exports
EXPORT_S3_ENDPOINT=http://localhost:9000
EXPORT_S3_REGION=us-east-1
EXPORT_S3_ACCESS_KEY_ID=rustfsadmin
EXPORT_S3_SECRET_ACCESS_KEY=rustfsadmin
EXPORT_S3_PREFIX=exports
EXPORT_S3_FORCE_PATH_STYLE=true
# Si le bucket devient public, cette base permet d'exposer une URL dans le rapport d'export.
# EXPORT_S3_PUBLIC_BASE_URL=

# === API BAN et services externes ===
# PORT=
# BAN_CORE_API_PORT=
# API_BAL_ASSEMBLY_URL=
# API_DEPOT_URL=
# BAN_API_URL=

# === Ancienne configuration MinIO (options conservees) ===
# MINIO_API_PORT=
# MINIO_CONSOLE_PORT=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# === Anciennes configurations S3 (options conservees) ===
# S3_CONFIG_ACCESS_KEY_ID=
# S3_CONFIG_SECRET_ACCESS_KEY=
# S3_CONFIG_REGION=
# S3_CONFIG_ENDPOINT=
# S3_CONFIG_BUCKETNAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_ENDPOINT=
# S3_BUCKETNAME=
# S3_MAXKEYS=
# S3_PORT=
