{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@ban/*": ["./packages/*/src"],
      "@prisma": ["./packages/prisma-client/generated/client/client.ts"],
      "@prisma/*": ["./packages/prisma-client/generated/client/*"]
    }
  }
}
